# ================================================================
# LEMMA — Plantilla de variables de entorno
# ================================================================
# Este archivo SÍ se commitea. Sirve de referencia para
# cualquier dev nuevo que clone el repo.
#
# Para trabajar: copiar a .env.local y completar con valores reales
# Comando: cp .env.local.example .env.local
# ================================================================

# ============ SUPABASE ============
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============ AMBIENTE ============
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============ INFO DEL LOCAL ============
NEXT_PUBLIC_LOCAL_NOMBRE=
NEXT_PUBLIC_LOCAL_CUIT=

# ============ MERCADO PAGO ============
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
# Random URL segment para reducir escaneo. Generá con: openssl rand -hex 16
# Si queda vacío, el handler acepta cualquier segment (warning en log; solo dev).
MP_WEBHOOK_PATH_SEGMENT=

# ============ SENTRY ============
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ================================================================
# AFIP — Facturación electrónica
# ================================================================
# Modo: 'homologation' | 'production'
# Sin set o vacío = adaptador mock (no toca AFIP real)
AFIP_MODE=

# CUIT del emisor (11 dígitos sin guiones)
AFIP_CUIT=

# Punto de venta default (1-9999)
AFIP_PUNTO_VENTA_DEFAULT=

# Certificado y clave privada como base64 del PEM completo.
# Para generar:
#   cat cert.crt | base64 -w0
#   cat privada.key | base64 -w0
# IMPORTANTE en Vercel: marcar como "Sensitive Env Var"
AFIP_CERT_B64=
AFIP_KEY_B64=
